# ─── Auth (NextAuth v5) ───────────────────────────────────────────────────────
# Anahtar üret: openssl rand -base64 32
AUTH_SECRET=

# Keycloak OIDC
AUTH_KEYCLOAK_ID=
AUTH_KEYCLOAK_SECRET=
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/<realm>

# Google OAuth (opsiyonel — değerleri doldurunca aktif olur)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# NextAuth base URL (client-side session provider uses this)
NEXTAUTH_URL=http://localhost:3000
