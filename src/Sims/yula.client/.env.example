# Veritabanı bağlantısı
# Docker Postgres kullanıyorsanız (varsayılan):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Yerel PGlite ile Docker'sız develop (true → local.db kullanır)
USE_PGLITE=false

# AI sağlayıcıları — bkz. README
AI_PROVIDER=foundry
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=
AGNES_API_KEY=
AGNES_BASE_URL=
AGNES_MODEL=

# Ollama (yerel)
OLLAMA_URL=http://localhost:11434
YULA_MODEL=gemma4:12b-mlx

# Backend
BACKEND_URL=http://localhost:5168
