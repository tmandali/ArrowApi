# ─── Auth (NextAuth v5) ───────────────────────────────────────────────────────
# Anahtar üret: openssl rand -base64 32
AUTH_SECRET=

# Keycloak OIDC (yerel: repo kökünde `docker compose up -d`)
# Admin konsolu: http://localhost:8080/admin (admin/admin)
AUTH_KEYCLOAK_ID=yula-client
AUTH_KEYCLOAK_SECRET=dev-yula-client-secret-change-me
KEYCLOAK_ISSUER=http://localhost:8080/realms/yula
# Prod örneği: KEYCLOAK_ISSUER=https://keycloak.example.com/realms/yula

# Google OAuth (opsiyonel — değerleri doldurunca aktif olur)
# AUTH_GOOGLE_ID hem OAuth redirect flow'u hem Google One Tap (GIS) için
# kullanılır; One Tap'te build'de NEXT_PUBLIC_GOOGLE_CLIENT_ID olarak
# client'a açılır (bkz. next.config.ts). Secret asla client'a verilmez.
AUTH_GOOGLE_ID=<GOOGLE_CLIENT_ID>.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=<GOOGLE_CLIENT_SECRET>
#
# Tek Google giriş noktası: GOOGLE_ONE_TAP
#   =1  → One Tap modu:
#         • sign-in kartındaki Google OAuth redirect butonu gizlenir;
#           yerine tıklanabilir GIS butonu (GoogleOneTapButton) çizilir.
#         • Global otomatik kart: root layout'taki GoogleOneTapPrompt her
#           TAM sayfa yüklenmesinde, oturum yokken ve /sign-in dışında
#           sağ üstte bir kez "Google ile devam et" kartını tetkler
#           (kayıtlı Google credential = FedCM varsa kartta hesap görünür).
#         • Giriş sonrası: /sign-in?next=<path> üzerindeyse hedefe yönlenir
#           (yoksa /); başka sayfalardaki global kartla girişte kalınan
#           sayfa oturum açılmış UI'a refresh edilir.
#   Boş/0 → klasik mod: Google girişi yalnızca sign-in kartındaki OAuth
#           redirect butonundandır; One Tap kartı/butonü çizilmez.
#
# DİKKATLER:
#   • Build-time env'dir (NEXT_PUBLIC_GOOGLE_ONE_TAP olarak inline edilir):
#     değişince dev sunucusu yeniden başlatılmalı / prod yeniden build.
#   • Google Cloud Console OAuth client'i (Web application):
#       - Authorized JavaScript origins: http://localhost ve http://127.0.0.1
#         (port'suz — loopback'te tüm portları kapsar); prod'da https://<domain>.
#       - Authorized Redirect URIs: http://localhost:<port>/api/auth/callback/google
#         (port'LU, tam eşleşme; prod'da https://<domain>/api/auth/callback/google).
#     origin listesi tam eşleşmezse GIS "origin_mismatch" (400) hatası verir.
#   • Otomatik kartta hesabın görünmesi için orijinde en az bir kez GIS ile
#     başarılı giriş (credential deposu) gerekir; ilk girişte buton kullanılır.
#   • Tarayıcıda site için "Üçüncü taraf oturum açma" (FedCM) izinli olmalı.
GOOGLE_ONE_TAP=

# NextAuth base URL (client-side session provider uses this)
NEXTAUTH_URL=http://localhost:56402
