{
  "name": "yula.client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 56402",
    "dev:next": "next dev -H 0.0.0.0 -p 56402",
    "dev:full": "npm-run-all --parallel db-server:file dev:next",
    "db-server:file": "pglite-server -m 100 --db=local.db --run \"npm run db:migrate\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -c -- drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "prebuild": "node scripts/copy-duckdb-assets.mjs && node scripts/copy-parquet-assets.mjs",
    "build": "next build",
    "start": "next start -p 56402",
    "lint": "oxlint",
    "copy:duckdb": "node scripts/copy-duckdb-assets.mjs",
    "copy:parquet": "node scripts/copy-parquet-assets.mjs",
    "test:grid": "node src/features/jobs/components/virtual-spreadsheet/tests/run-all.mjs",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/i18n-check-wrapper.js"
  },
  "dependencies": {
    "@ai-sdk/azure": "^4.0.56",
    "@ai-sdk/openai": "^4.0.53",
    "@ai-sdk/react": "^4.0.86",
    "@base-ui/react": "^1.7.0",
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@react-pdf/renderer": "^4.9.0",
    "@shadcn/react": "^0.3.1",
    "@types/js-yaml": "^4.0.9",
    "ai": "^7.0.83",
    "apache-arrow": "^21.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "js-yaml": "^5.4.1",
    "lucide-react": "^1.34.0",
    "marked": "^18.0.11",
    "next": "^16.3.5",
    "next-intl": "^4.14.4",
    "next-themes": "^0.4.6",
    "ollama-ai-provider-v2": "^4.0.1",
    "parquet-wasm": "^0.7.2",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.80.0",
    "raw-loader": "^4.0.2",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
