{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yula",
  "version": "0.1.0",
  "identifier": "com.arrowapi.yula",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:56402",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Yula",
        "width": 1360,
        "height": 860,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/main"
    ]
  },
  "plugins": {
    "shell": {
      "open": "^((mailto:\\w+)|(tel:\\w+)|(https?://\\w+)).+|^.*/yula-exports/.+$|^.:.*yula-exports.+$"
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkKUldUUFlPVVJfUFVCTElDX0tFWV9IRVJFX0ZST01fVEFVUklfU0lHTkVSX0dFTkVSQVRFCg==",
      "endpoints": [
        "https://raw.githubusercontent.com/tmandali/ArrowApi/main/releases/latest.json"
      ]
    }
  }
}