{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rapor Kriterleri",
  "description": "Stock Balance raporu için filtre kriterlerini tanımlayın.",
  "type": "object",
  "properties": {
    "kayitTarihi": {
      "type": "object",
      "format": "date",
      "title": "Kayıt Tarihi",
      "description": "Takvimden başlangıç ve bitiş tarihi seçin; tek gün de seçilebilir.",
      "x-mode": "range",
      "required": ["from", "to"],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^\\d{8}$"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d{8}$"
        }
      }
    },
    "durum": {
      "type": "array",
      "title": "Evrak Durumu",
      "x-selection": "multiple",
      "items": {
        "type": "string",
        "enum": ["AKTIF", "PASIF", "BEKLEMEDE", "IPTAL"]
      }
    },
    "tutarMiktar": {
      "type": "number",
      "title": "Tutar",
      "description": "Filtrelenecek parasal miktar",
      "minimum": 0
    },
    "tutarParaBirimi": {
      "type": "string",
      "title": "Para Birimi",
      "description": "Tutarın döviz cinsi",
      "enum": ["TRY", "USD", "EUR"],
      "x-selection": "single",
      "default": "TRY"
    },
    "urun": {
      "type": "array",
      "title": "Ürün Bilgileri",
      "description": "Listeden bir veya birden fazla ürün seçin.",
      "x-selection": "multiple",
      "items": {
        "type": "string"
      },
      "properties": {
        "kod": { "type": "string", "title": "Ürün Kodu" },
        "ad": { "type": "string", "title": "Ürün Adı" },
        "barkod": {
          "type": "string",
          "title": "Ürün Barkodu",
          "pattern": "^\\d{13}$"
        }
      },
      "x-datasource": [
        { "kod": "1", "ad": "Ürün 1", "barkod": "1234567890123" },
        { "kod": "2", "ad": "Ürün 2", "barkod": "9876543210987" },
        { "kod": "3", "ad": "Ürün 3", "barkod": "1111111111111" },
        { "kod": "4", "ad": "Ürün 4", "barkod": "2222222222222" },
        { "kod": "5", "ad": "Ürün 5", "barkod": "3333333333333" },
        { "kod": "6", "ad": "Ürün 6", "barkod": "4444444444444" },
        { "kod": "7", "ad": "Ürün 7", "barkod": "5555555555555" },
        { "kod": "8", "ad": "Ürün 8", "barkod": "6666666666666" },
        { "kod": "9", "ad": "Ürün 9", "barkod": "7777777777777" },
        { "kod": "10", "ad": "Ürün 10", "barkod": "8888888888888" },
        { "kod": "11", "ad": "Ürün 11", "barkod": "9999999999999" },
        { "kod": "12", "ad": "Ürün 12", "barkod": "1010101010101" }
      ]
    }
  },
  "required": ["kayitTarihi"]
}
