{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stok Analitik Raporu (Stock Analytics)",
  "description": "Dönemsel stok hareketlerini, maliyet analizlerini, defter ve para birimi bazlı stok trendlerini sorgular.",
  "x-scope": "stock-analytics",
  "x-page-path": "/stock/stock-analytics",
  "x-ai": {
    "schemaVersion": 1,
    "aliases": [
      "stok analiz",
      "stok analizi",
      "stok analiz raporu",
      "stok analitik",
      "stok analitiği",
      "maliyet analizi",
      "trend raporu",
      "stock analytics",
      "dönemsel analiz",
      "analiz raporu"
    ],
    "directive": "Kullanıcı tarih aralığı belirtmediğinde son 30 günü varsayılan yap ve kullanıcıya 'son 7 gün' veya 'bu yıl' seçeneklerini öner.",
    "quickPrompts": [
      "Son 30 günün analitiğini hazırla",
      "Son 7 gün (TRY)",
      "Mali Yıl: 2025-2026"
    ],
    "resultsPrompts": [
      "🚨 Riskli Kapanış & Anomali Analizi",
      "En Yüksek 5 Maliyet / Borç Kalemi",
      "Dönem İçi Giriş ve Çıkış Özeti",
      "Filtreleri Temizle"
    ]
  },
  "x-job-endpoint": "/api/arrow/jobs/stock-analytics",
  "type": "object",
  "properties": {
    "fromDate": {
      "type": "string",
      "format": "date",
      "title": "Başlangıç Tarihi",
      "description": "Analiz başlangıç tarihi (YYYY-MM-DD formatında, örn: '2026-08-01')",
      "x-ai": {
        "intent": "analysis_start_date",
        "priority": 100,
        "columnHints": [
          "PostingDate",
          "date",
          "movement_date"
        ],
        "dateBehavior": "range_start",
        "suggestions": [
          "son 30 gün",
          "bu ay başı",
          "son 7 gün",
          "bu yıl başı"
        ],
        "directive": "Analiz dönemi başlangıcıdır; kullanıcı tek tarih verdiyse bile dönem aralığı kurulmalıdır."
      }
    },
    "toDate": {
      "type": "string",
      "format": "date",
      "title": "Bitiş Tarihi",
      "description": "Analiz bitiş tarihi (YYYY-MM-DD formatında, örn: '2026-08-19')",
      "x-ai": {
        "intent": "analysis_end_date",
        "priority": 100,
        "columnHints": [
          "PostingDate",
          "date",
          "movement_date"
        ],
        "dateBehavior": "range_end",
        "suggestions": [
          "bugün",
          "dün",
          "ay sonu"
        ],
        "directive": "Analiz dönemi bitişidir; belirtilmediyse bugün kabul edilir."
      }
    },
    "fiscalYear": {
      "type": "string",
      "title": "Mali Yıl",
      "description": "Raporun ait olduğu mali çalışma yılı.",
      "enum": [
        "2025-2026",
        "2024-2025"
      ],
      "x-selection": "single",
      "x-ai": {
        "intent": "fiscal_year",
        "suggestions": [
          "2025-2026",
          "2024-2025"
        ],
        "directive": "Kullanıcı mali yıl/mali dönem belirttiğinde enum değerlerinden birebir birini seç; emin değilsen boş bırak."
      }
    },
    "financeBook": {
      "type": "string",
      "title": "Finans Defteri",
      "description": "Resmi veya vergi defteri ayrımı.",
      "enum": [
        "Main Book",
        "Tax Book"
      ],
      "x-selection": "single",
      "default": "Main Book",
      "x-ai": {
        "intent": "finance_book",
        "suggestions": [
          "Main Book",
          "Tax Book"
        ],
        "directive": "Kullanıcı 'vergi defteri' derse Tax Book, aksi halde varsayılan Main Book."
      }
    },
    "currency": {
      "type": "string",
      "title": "Para Birimi",
      "description": "Raporlama para birimi. Varsayılan TRY.",
      "enum": [
        "TRY",
        "USD",
        "EUR"
      ],
      "x-selection": "single",
      "default": "TRY",
      "x-ai": {
        "intent": "currency",
        "suggestions": [
          "TRY",
          "USD",
          "EUR"
        ],
        "directive": "Rapor para birimidir; tutar filtrelerinden bağımsızdır."
      }
    },
    "valuesMode": {
      "type": "string",
      "title": "Değer Gösterim Modu",
      "description": "Tüm değerler veya özet gösterim.",
      "enum": [
        "all",
        "5-values"
      ],
      "x-selection": "single",
      "default": "all",
      "x-ai": {
        "intent": "display_preference",
        "directive": "Görüntüleme tercihidir; AI yalnızca kullanıcı açıkça isterse doldurur, aksi halde varsayılan kalır."
      }
    },
    "showZeroValues": {
      "type": "boolean",
      "title": "Sıfır Değerleri Göster",
      "description": "Bakiyesi sıfır olan hesapların gösterilip gösterilmeyeceği.",
      "default": false,
      "x-ai": {
        "intent": "display_preference",
        "directive": "Görüntüleme tercihidir; AI yalnızca kullanıcı açıkça isterse doldurur, aksi halde varsayılan kalır."
      }
    },
    "showGroupAccounts": {
      "type": "boolean",
      "title": "Grup Hesaplarını Göster",
      "description": "Ana grup başlıklarının dahil edilmesi.",
      "default": true,
      "x-ai": {
        "intent": "display_preference",
        "directive": "Görüntüleme tercihidir; AI yalnızca kullanıcı açıkça isterse doldurur, aksi halde varsayılan kalır."
      }
    },
    "sampleRows": {
      "type": "integer",
      "title": "Test Satır Sayısı",
      "description": "Mock ağaç düğüm sayısı. Devasa testler için 1000000 yazılabilir.",
      "minimum": 1,
      "x-ai": {
        "intent": "test_only",
        "directive": "AI bu alanı ASLA doldurmaz ve önermez; yalnızca geliştirici test verisi üretimi içindir."
      }
    }
  },
  "additionalProperties": false
}
