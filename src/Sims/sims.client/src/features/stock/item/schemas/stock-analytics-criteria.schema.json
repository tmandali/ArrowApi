{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stok Analitik Raporu (Stock Analytics)",
  "description": "Dönemsel stok hareketlerini, maliyet analizlerini, defter ve para birimi bazlı stok trendlerini sorgular.",
  "x-scope": "stock-analytics",
  "x-page-path": "/stock/analytics",
  "x-ai-aliases": ["stok analitik", "stok analitiği", "maliyet analizi", "trend raporu", "stock analytics", "dönemsel analiz"],
  "x-ai-directive": "Kullanıcı tarih aralığı belirtmediğinde son 30 günü varsayılan yap ve kullanıcıya 'son 7 gün' veya 'bu yıl' seçeneklerini öner.",
  "x-ai-quick-prompts": [
    "Son 30 günün analitiğini hazırla",
    "Son 7 gün (TRY)",
    "Mali Yıl: 2025-2026"
  ],
  "x-job-endpoint": "/api/arrow/jobs/stock-analytics",
  "type": "object",
  "properties": {
    "fromDate": {
      "type": "string",
      "format": "date",
      "title": "Başlangıç Tarihi",
      "description": "Analiz başlangıç tarihi (YYYY-MM-DD formatında, örn: '2026-08-01')",
      "x-date-behavior": "range_start",
      "x-ai-suggestions": ["son 30 gün", "bu ay başı", "son 7 gün", "bu yıl başı"]
    },
    "toDate": {
      "type": "string",
      "format": "date",
      "title": "Bitiş Tarihi",
      "description": "Analiz bitiş tarihi (YYYY-MM-DD formatında, örn: '2026-08-19')",
      "x-date-behavior": "range_end",
      "x-ai-suggestions": ["bugün", "dün", "ay sonu"]
    },
    "fiscalYear": {
      "type": "string",
      "title": "Mali Yıl",
      "description": "Raporun ait olduğu mali çalışma yılı.",
      "enum": ["2025-2026", "2024-2025"],
      "x-selection": "single",
      "x-ai-suggestions": ["2025-2026", "2024-2025"]
    },
    "financeBook": {
      "type": "string",
      "title": "Finans Defteri",
      "description": "Resmi veya vergi defteri ayrımı.",
      "enum": ["Main Book", "Tax Book"],
      "x-selection": "single",
      "default": "Main Book"
    },
    "currency": {
      "type": "string",
      "title": "Para Birimi",
      "description": "Raporlama para birimi (try, usd, inr).",
      "enum": ["try", "usd", "inr"],
      "x-selection": "single",
      "default": "try",
      "x-ai-suggestions": ["try", "usd", "eur"]
    },
    "valuesMode": {
      "type": "string",
      "title": "Değer Gösterim Modu",
      "description": "Tüm değerler veya özet gösterim.",
      "enum": ["all", "5-values"],
      "x-selection": "single",
      "default": "all"
    },
    "showZeroValues": {
      "type": "boolean",
      "title": "Sıfır Değerleri Göster",
      "description": "Bakiyesi sıfır olan hesapların gösterilip gösterilmeyeceği.",
      "default": false
    },
    "showGroupAccounts": {
      "type": "boolean",
      "title": "Grup Hesaplarını Göster",
      "description": "Ana grup başlıklarının dahil edilmesi.",
      "default": true
    },
    "sampleRows": {
      "type": "integer",
      "title": "Test Satır Sayısı",
      "description": "Mock ağaç düğüm sayısı. Devasa testler için 1000000 yazılabilir.",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
